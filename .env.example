# TVDB API v4 key — free at https://thetvdb.com/dashboard/account/apikey
# Used by the web UI for season correlation. Leave empty to disable TVDB features.
TVDB_API_KEY=

# Log level for bot and web containers (DEBUG, INFO, WARNING, ERROR). Default: INFO
LOGLEVEL=INFO

# ----------------------------------------------------------------------------
# Deployment — host paths, Docker network, identity (REQUIRED)
# docker-compose.yml has no defaults for these; an unset value fails the deploy
# loudly rather than guessing. Fill each in to match your host (the comments
# show the expected format).
# ----------------------------------------------------------------------------
# External Docker network the containers join (must already exist). e.g. media-net
ANIME_NETWORK=
# Host dir bind-mounted as /config (ani.json, logs, web-prefs). e.g. /srv/anime-loads/config
ANIME_CONFIG_DIR=
# Host data root bind-mounted as /data (downloads + media library). e.g. /srv/media
ANIME_DATA_DIR=
# Host dir JDownloader writes completed downloads to (its /output). e.g. /srv/media/downloads/anime
ANIME_DOWNLOAD_DIR=
# Host dir deploy unpacks into; web live-mounts web/app.py from here. e.g. /srv/anime-loads/setup
ANIME_SETUP_DIR=
# User/group the containers run as — owner of the media share. e.g. 1000
PUID=
PGID=
# GID of the host's docker group; web needs it for docker.sock access. e.g. 999
DOCKER_GID=
# Timezone for the containers (optional; defaults to UTC). e.g. Europe/Berlin
TZ=

# ----------------------------------------------------------------------------
# anime-loads.org login (optional; required only for Click'n'Load batch downloads)
# ----------------------------------------------------------------------------
AL_USER=
AL_PASS=

# ----------------------------------------------------------------------------
# Selenium / browser timing (bot container)
# ----------------------------------------------------------------------------
# Page-load timeout (seconds) for the DDoS-Guard homepage hit during init.
SELENIUM_HOMEPAGE_LOAD_TIMEOUT=30
# Page-load timeout (seconds) for anime / episode / batch pages.
SELENIUM_PAGE_LOAD_TIMEOUT=60
# Sleep (seconds) after homepage load to let DDoS-Guard + ads finish.
BROWSER_INIT_WAIT=3
# Sleep (seconds) after anime-page load (updateInfo / batch refresh).
BROWSER_PAGE_WAIT=10
# Sleep (seconds) before the XHR on episode / batch download pages.
BROWSER_DOWNLOAD_PAGE_WAIT=15

# ----------------------------------------------------------------------------
# Captcha jitter — random delays between captcha steps (anti-detection).
# WARNING: Lowering these below the defaults increases bot-detection risk.
# Each pair is the (min, max) for random.uniform().
# ----------------------------------------------------------------------------
CAPTCHA_FETCH_DELAY_MIN=1.5
CAPTCHA_FETCH_DELAY_MAX=3.0
CAPTCHA_VERIFY_DELAY_MIN=0.8
CAPTCHA_VERIFY_DELAY_MAX=2.0
CAPTCHA_DOWNLOAD_DELAY_MIN=0.5
CAPTCHA_DOWNLOAD_DELAY_MAX=1.5

# ----------------------------------------------------------------------------
# Retry backoff
# ----------------------------------------------------------------------------
# Random delay (seconds) before retrying nocaptcha when CNL data is missing.
CNL_RETRY_DELAY_MIN=5
CNL_RETRY_DELAY_MAX=10

# ----------------------------------------------------------------------------
# HTTP timeouts (seconds)
# ----------------------------------------------------------------------------
# Timeout for JDownloader Flashgot / addcrypted2 / linkgrabber endpoints.
JD_HTTP_TIMEOUT=30
# Timeout for TVDB API requests (login, series, episodes).
TVDB_HTTP_TIMEOUT=10
# Timeout for the Docker API unix-socket read in the web container.
DOCKER_SOCKET_TIMEOUT=10

# ----------------------------------------------------------------------------
# Web container — background threads
# ----------------------------------------------------------------------------
# Initial sleep (seconds) before the resolve_pending thread starts work.
RESOLVE_PENDING_STARTUP_DELAY=10
# Sleep (seconds) when the pending list is empty.
RESOLVE_PENDING_EMPTY_INTERVAL=60
# Throttle (seconds) between resolving each pending entry.
RESOLVE_PENDING_PER_ENTRY_DELAY=5
# Sleep (seconds) after a resolve batch completes.
RESOLVE_PENDING_BATCH_INTERVAL=120
# Initial sleep (seconds) before the file mover thread starts.
MOVE_STARTUP_DELAY=30
# File mover poll interval (seconds). The "Move Now" button still triggers immediately.
MOVE_POLL_SECONDS=300
# Minimum file age (minutes) before a completed download is moved to the media library.
MIN_AGE_MINUTES=5
